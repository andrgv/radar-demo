{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "carlyworkspace:upenn-mmwave",
  "visibility": "private",
  "url": "https://github.com/andrgv/radar-demo",
  "description": "Infineon radar sensor and raw-ADC point-cloud camera sharing one acquisition stream.",
  "markdown_link": "docs/VIAM.md",
  "entrypoint": "dist/upenn-mmwave",
  "models": [
    {
      "api": "rdk:component:sensor",
      "model": "carlyworkspace:upenn-mmwave:infineon-mmwave"
    },
    {
      "api": "rdk:component:camera",
      "model": "carlyworkspace:upenn-mmwave:mmwave-pointcloud"
    }
  ],
  "build": {
    "setup": "bash setup.sh",
    "build": "bash build.sh",
    "path": "dist/upenn-mmwave.tar.gz",
    "arch": [
      "darwin/arm64",
      "linux/arm64",
      "linux/amd64"
    ]
  }
}
